// central color/font palette, populated from Rust at startup and whenever the user changes theme
// settings - see src/gui/theme.rs -> apply_palette
export global AppPalette {
    in-out property <color> background-color;
    in-out property <color> label-color;
    in-out property <color> secondary-label-color;
    in-out property <color> muted-label-color;
    in-out property <color> stroke-color;
    in-out property <color> secondary-stroke-color;
    in-out property <color> highlight-background-color;
    in-out property <color> secondary-background-color;
    in-out property <color> accent-color;
    in-out property <color> text-color;
    in-out property <color> about-background-color;

    in-out property <length> browser-label-size: 12px;
    in-out property <length> profile-label-size: 11px;
    in-out property <length> url-label-size: 12px;

    in-out property <color> label-color-hover;
    in-out property <color> secondary-label-color-hover;
    in-out property <color> hotkey-background-color-hover;
    in-out property <color> hotkey-text-color-hover;

    // picker popup selection: accent fill with light text, or a neutral fill while ⇧ (private) is
    // held
    in-out property <color> selection-background-color;
    in-out property <color> selection-label-color;
    in-out property <color> selection-secondary-label-color;
    in-out property <color> neutral-selection-background-color;
    in-out property <color> separator-color;
    in-out property <color> pill-background-color;
}
