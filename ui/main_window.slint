import { ListView } from "std-widgets.slint";
import { AppPalette } from "theme.slint";
import { Layout } from "common.slint";

export struct BrowserItem {
    image: image,
    profile-image: image,
    browser-name: string,
    profile-name: string,
    full-name: string,
    show-incognito: bool,
    hotkey: string,
    show-hotkey: bool,
    unique-id: string,
    unique-app-id: string,
    browser-profile-index: int,
    filtered-index: int,
    is-first: bool,
    is-last: bool,
    has-priority-ordering: bool,
    supports-profiles: bool,
    // letter + color for the fallback avatar of a profile that has no picture of its own
    profile-initial: string,
    avatar-color: color,
}

// profile picture (or the app icon when the app has no profiles), with a small app-icon badge in
// the corner for profile rows, so five Chrome profiles don't turn into five identical Chrome icons
component Avatar inherits Rectangle {
    in property <BrowserItem> item;
    in property <length> icon-size;
    // ring around the badge, so it reads as separate from the avatar under it
    in property <color> badge-ring-color;

    property <bool> has-profile-image: item.profile-image.width > 0;

    width: 28px;
    height: 28px;

    if !item.supports-profiles: Image {
        source: item.image;
        width: root.icon-size;
        height: root.icon-size;
        image-fit: contain;
    }

    if item.supports-profiles && root.has-profile-image: Image {
        source: item.profile-image;
        x: 1px;
        y: 1px;
        width: 24px;
        height: 24px;
        image-fit: cover;
    }

    if item.supports-profiles && !root.has-profile-image: Rectangle {
        x: 1px;
        y: 1px;
        width: 24px;
        height: 24px;
        border-radius: self.width / 2;
        background: item.avatar-color;
        Text {
            text: item.profile-initial;
            color: white;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if item.supports-profiles: Rectangle {
        x: root.width - self.width + 1px;
        y: root.height - self.height + 1px;
        width: 15px;
        height: 15px;
        border-radius: self.width / 2;
        background: root.badge-ring-color;
        Image {
            source: item.image;
            // macOS app icons carry their own transparent margin, so they need a bit more size to
            // look the same as the tightly cropped icons on other platforms
            width: Platform.os == OperatingSystemType.macos ? 15px : 11px;
            height: self.width;
            image-fit: contain;
        }
    }
}

component BrowserRow inherits Rectangle {
    in property <BrowserItem> item;
    in property <bool> incognito-mode;
    in property <bool> is-focused;
    in property <length> icon-size: 24px;
    in property <string> url-domain;

    callback open(int, bool);
    callback hide-profile(string);
    callback hide-app(string);
    callback set-focused(int);
    callback shift-changed(bool);
    callback copy-link();
    callback always-open-here(string, int);
    callback show-settings();

    width: 100%;
    height: Layout.browser-row-height;

    // rows that can't open a private window fade out while ⇧ is held
    property <bool> private-unavailable: root.incognito-mode && !item.show-incognito;
    // holding ⇧ turns the selection neutral, so it doesn't look like a regular open is about to
    // happen
    property <bool> accent-selected: root.is-focused && !root.incognito-mode;
    property <bool> shift-on-press: false;

    opacity: root.private-unavailable ? 0.4 : 1.0;

    Rectangle {
        x: Layout.picker-inset;
        width: parent.width - 2 * Layout.picker-inset;
        border-radius: 6px;
        background: !root.is-focused ? transparent
            : root.incognito-mode ? AppPalette.neutral-selection-background-color
            : AppPalette.selection-background-color;
    }

    ta := TouchArea {
        clicked => {
            root.open(item.browser-profile-index, root.incognito-mode || root.shift-on-press);
        }
        // TouchArea's moved callback only fires while the mouse is pressed (dragging), not on
        // plain hover.
        // pointer-event's Move kind fires regardless, which is what we want here - only an actual
        // mouse move takes the selection, a list scrolling under a still cursor doesn't.
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.set-focused(item.filtered-index);
                root.shift-changed(event.modifiers.shift);
            }
            if (event.kind == PointerEventKind.down) {
                root.shift-on-press = event.modifiers.shift;
            }
        }
    }

    // declared after ta on purpose: siblings hit-test front-to-back in declaration order, so
    // being last makes cm the frontmost one. a TouchArea grabs every press it sees regardless of
    // button, so with cm behind ta a right-click would never reach it no matter how it's sized.
    // being in front, cm gets first look at every press, handles the right-click/Menu-key itself,
    // and otherwise ignores the event so it falls through to ta underneath for left-click/hover.
    // it also still needs an explicit size - it has no visual children of its own (just a
    // non-visual Menu), so without one it defaults to 0x0 and never receives a click at all.
    cm := ContextMenuArea {
        width: 100%;
        height: 100%;
        Menu {
            if item.show-incognito: MenuItem {
                title: "Open in Private Window";
                activated => { root.open(item.browser-profile-index, true); }
            }
            MenuItem {
                title: "Copy Link";
                activated => { root.copy-link(); }
            }
            if root.url-domain != "": MenuItem {
                title: "Always open \{root.url-domain} here";
                activated => { root.always-open-here(item.unique-id, item.browser-profile-index); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Hide \{item.full-name}";
                activated => { root.hide-profile(item.unique-id); }
            }
            if item.supports-profiles: MenuItem {
                title: "Hide All \{item.browser-name} Profiles";
                activated => { root.hide-app(item.unique-app-id); }
            }
            MenuItem {
                title: "Manage Browsers…";
                activated => { root.show-settings(); }
            }
        }
    }

    HorizontalLayout {
        padding-left: Layout.picker-inset + 8px;
        padding-right: Layout.picker-inset + 10px;
        spacing: 10px;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            Avatar {
                item: root.item;
                icon-size: root.icon-size;
                badge-ring-color: root.is-focused && !root.incognito-mode
                    ? AppPalette.selection-background-color
                    : AppPalette.background-color.with-alpha(1);
            }
        }

        // profile first - it's what you're actually choosing - the app it belongs to second
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 0px;
            Text {
                text: item.supports-profiles ? item.profile-name : item.browser-name;
                font-size: AppPalette.browser-label-size;
                font-weight: 500;
                color: root.accent-selected ? AppPalette.selection-label-color : AppPalette.label-color;
                overflow: elide;
            }
            if item.supports-profiles: Text {
                text: item.browser-name;
                font-size: AppPalette.profile-label-size;
                color: root.accent-selected
                    ? AppPalette.selection-secondary-label-color
                    : AppPalette.secondary-label-color;
                overflow: elide;
            }
        }

        // ⏎ on the selected row says what Return does, the other rows show their 1-9 hotkey
        Text {
            property <bool> shows-return: root.is-focused && !root.private-unavailable;
            text: self.shows-return ? (root.incognito-mode ? "⇧⏎" : "⏎")
                : item.show-hotkey ? item.hotkey : "";
            width: 22px;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: 11px;
            color: root.accent-selected ? AppPalette.selection-secondary-label-color : AppPalette.muted-label-color;
        }
    }
}

// one "⌘C Copy" style hint in the bottom action bar
component ActionHint inherits HorizontalLayout {
    in property <string> keys;
    in property <string> label;
    spacing: 4px;
    Text {
        text: root.keys;
        font-size: 11px;
        font-weight: 600;
        color: AppPalette.secondary-label-color;
        vertical-alignment: center;
    }
    Text {
        text: root.label;
        font-size: 11px;
        color: AppPalette.muted-label-color;
        vertical-alignment: center;
    }
}

export struct RestorableProfile {
    unique-id: string,
    full-name: string,
}

export component MainWindow inherits Window {
    no-frame: true;
    background: transparent;
    always-on-top: true;
    // borderless windows get an invisible resize-hit-region near the edges by default (winit),
    // which was showing a resize cursor right over the "···" options button in the corner - this
    // popup is never meant to be resizable anyway (Rust sizes it based on content), so just turn
    // the hit-region off
    resize-border-width: 0px;
    // winit derives its own "is this window resizable" purely from min-size < max-size, and
    // recomputes it (silently overriding Rust's one-time set_resizable(false) call) every time
    // this window's layout constraints change - which happens right after launch once the
    // browser list loads and the window resizes to fit it. Pinning min/max here keeps that
    // recompute permanently landing on "not resizable" instead of racing Rust's single early
    // call, which is what let the OS resize cursor show up over the window edges when the
    // cursor happened to be there right as the constraints flipped back.
    // these mirror the size Rust already computes and passes to window().set_size() (see
    // apply_main_window_size in app.rs) - binding straight to root.width/root.height instead
    // would be circular (width's own layout info would depend on itself), which slint-viewer
    // flags as a binding-loop warning that risks a runtime panic.
    in property <length> pinned-width: 300px;
    in property <length> pinned-height: 300px;
    min-width: pinned-width;
    max-width: pinned-width;
    min-height: pinned-height;
    max-height: pinned-height;

    // the popup's fixed width, and the height of everything around the rows - Rust adds the rows
    // on top of this to size the window, see apply_main_window_size in app.rs
    out property <length> popup-width: 300px;
    out property <length> chrome-height: 2 * root.border-width + root.header-height
        + 2 * root.separator-height + 2 * Layout.picker-inset + root.action-bar-height;

    in property <[BrowserItem]> browsers;
    in property <[RestorableProfile]> restorable-app-profiles;
    // link shown in the header, split so the domain can lead and the path can elide on its own
    in property <string> url-domain;
    in property <string> url-path;
    // name of the app the link was clicked in ("Slack"), empty if unknown
    in property <string> source-app-name;
    in property <bool> show-set-as-default;
    in property <length> icon-size: 24px;
    in-out property <bool> incognito-mode: false;
    in-out property <int> focused-index: 0;
    // type-to-filter query, Rust narrows `browsers` down to it - see filter-changed
    in-out property <string> filter-text;

    property <length> border-width: 1px;
    property <length> header-height: 50px;
    property <length> separator-height: 1px;
    property <length> action-bar-height: 30px;
    property <bool> link-copied: false;
    property <bool> caret-on: true;

    callback open-browser(int, bool);
    callback activate-focused();
    callback open-hotkey(int);
    callback hide-profile(string);
    callback hide-app(string);
    callback restore-profile(string);
    callback always-open-here(string, int);
    callback refresh();
    callback set-browsers-default();
    callback show-settings();
    callback show-about();
    callback copy-link();
    callback quit();
    // closes the popup without opening a link - hides it when running in the background
    callback dismiss();
    callback grab-focus();
    callback filter-changed();
    // returns the filter text after typing `key` into it (appending a character, Backspace, ...),
    // or `current` unchanged if the key doesn't edit the filter at all
    pure callback edit-filter(current: string, key: string) -> string;

    // puts the popup back to how it looks when freshly opened, for reusing the same window for
    // the next link instead of creating a new one
    callback reset-state();
    reset-state => {
        root.filter-text = "";
        root.focused-index = 0;
        root.incognito-mode = false;
        root.link-copied = false;
        browser-list.content-y = 0;
    }

    changed filter-text => {
        browser-list.content-y = 0;
        root.filter-changed();
    }

    function ensure-focused-visible() {
        if (root.browsers.length > 0) {
            let row-height = Layout.browser-row-height;
            let row-top = root.focused-index * row-height;
            let row-bottom = row-top + row-height;
            let visible-top = -browser-list.content-y;
            let visible-bottom = visible-top + browser-list.visible-height;

            if (row-top < visible-top) {
                browser-list.content-y = -row-top;
            } else if (row-bottom > visible-bottom) {
                browser-list.content-y = browser-list.visible-height - row-bottom;
            }
        }
    }

    function copy-link-with-feedback() {
        root.copy-link();
        root.link-copied = true;
    }

    grab-focus => { fs.focus(); }

    Timer {
        interval: 1.5s;
        running: root.link-copied;
        triggered => { root.link-copied = false; }
    }

    Timer {
        interval: 530ms;
        running: root.filter-text != "";
        triggered => { root.caret-on = !root.caret-on; }
    }

    dialog := Rectangle {
        width: 100%;
        height: root.pinned-height;
        background: AppPalette.background-color;
        border-color: AppPalette.stroke-color;
        border-width: root.border-width;
        border-radius: 10px;
        clip: true;

        fs := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    // the first Esc only clears the filter, the next one closes
                    if (root.filter-text != "") {
                        root.filter-text = "";
                    } else {
                        root.dismiss();
                    }
                    return accept;
                }
                if (event.text == Key.Return || (event.text == " " && root.filter-text == "")) {
                    root.activate-focused();
                    return accept;
                }
                if (event.text == Key.Shift) {
                    root.incognito-mode = true;
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    if (root.browsers.length > 0) {
                        root.focused-index = max(0, root.focused-index - 1);
                        root.ensure-focused-visible();
                    }
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    if (root.browsers.length > 0) {
                        root.focused-index = min(root.browsers.length - 1, root.focused-index + 1);
                        root.ensure-focused-visible();
                    }
                    return accept;
                }
                if (event.modifiers.control || event.modifiers.meta) {
                    if (event.text == "c") { root.copy-link-with-feedback(); return accept; }
                    if (event.text == ",") { root.show-settings(); return accept; }
                    return reject;
                }
                let edited = root.edit-filter(root.filter-text, event.text);
                if (edited != root.filter-text) {
                    root.filter-text = edited;
                    root.caret-on = true;
                    return accept;
                }
                return reject;
            }
            key-released(event) => {
                if (event.text == Key.Shift) {
                    root.incognito-mode = false;
                    return accept;
                }
                return reject;
            }

            KeyBinding { keys: @keys("1"); activated => { root.open-hotkey(0); } }
            KeyBinding { keys: @keys("2"); activated => { root.open-hotkey(1); } }
            KeyBinding { keys: @keys("3"); activated => { root.open-hotkey(2); } }
            KeyBinding { keys: @keys("4"); activated => { root.open-hotkey(3); } }
            KeyBinding { keys: @keys("5"); activated => { root.open-hotkey(4); } }
            KeyBinding { keys: @keys("6"); activated => { root.open-hotkey(5); } }
            KeyBinding { keys: @keys("7"); activated => { root.open-hotkey(6); } }
            KeyBinding { keys: @keys("8"); activated => { root.open-hotkey(7); } }
            KeyBinding { keys: @keys("9"); activated => { root.open-hotkey(8); } }

            VerticalLayout {
                padding: root.border-width;
                spacing: 0px;

                // where the link goes: domain first, path second, app it came from on the side.
                // the filter query and the private-window pill take over this spot when active.
                header := Rectangle {
                    height: root.header-height;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.copy-link-with-feedback(); }
                    }

                    if root.filter-text == "" && !root.incognito-mode: VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.url-domain != "" ? root.url-domain : "No link";
                                horizontal-stretch: 1;
                                font-size: 13px;
                                font-weight: 600;
                                color: AppPalette.label-color;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            if root.link-copied || root.source-app-name != "": Text {
                                text: root.link-copied ? "Link copied" : "from \{root.source-app-name}";
                                font-size: 11px;
                                color: AppPalette.muted-label-color;
                                vertical-alignment: center;
                            }
                        }
                        if root.url-path != "": Text {
                            text: root.url-path;
                            font-size: 11px;
                            color: AppPalette.muted-label-color;
                            overflow: elide;
                        }
                    }

                    if root.filter-text != "" || root.incognito-mode: HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;

                        if root.incognito-mode: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 20px;
                                border-radius: self.height / 2;
                                background: AppPalette.pill-background-color;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "Private window";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: AppPalette.label-color;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // the query hugs its text with the caret right after it, instead of
                        // stretching and leaving the caret floating mid-header
                        if root.filter-text != "": Rectangle {
                            horizontal-stretch: 0;
                            width: min(query.preferred-width, 170px) + 3px;
                            query := Text {
                                x: 0;
                                width: parent.width - 3px;
                                text: root.filter-text;
                                font-size: 13px;
                                color: AppPalette.label-color;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle {
                                x: query.width + 1px;
                                width: 1.5px;
                                height: 15px;
                                background: AppPalette.label-color;
                                opacity: root.caret-on ? 1 : 0;
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Text {
                            text: root.link-copied ? "Link copied" : root.url-domain;
                            font-size: 11px;
                            color: AppPalette.muted-label-color;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    height: root.separator-height;
                    background: AppPalette.separator-color;
                }

                VerticalLayout {
                    padding-top: Layout.picker-inset;
                    padding-bottom: Layout.picker-inset;
                    vertical-stretch: 1;

                    Rectangle {
                        browser-list := ListView {
                            for item[idx] in root.browsers: BrowserRow {
                                item: item;
                                incognito-mode: root.incognito-mode;
                                is-focused: item.filtered-index == root.focused-index;
                                icon-size: root.icon-size;
                                url-domain: root.url-domain;
                                open(profile-index, private) => { root.open-browser(profile-index, private); }
                                hide-profile(id) => { root.hide-profile(id); }
                                hide-app(id) => { root.hide-app(id); }
                                set-focused(i) => { root.focused-index = i; }
                                shift-changed(shift) => { root.incognito-mode = shift; }
                                copy-link => { root.copy-link-with-feedback(); }
                                always-open-here(id, profile-index) => {
                                    root.always-open-here(id, profile-index);
                                }
                                show-settings => { root.show-settings(); }
                            }
                        }

                        if root.browsers.length == 0: Text {
                            text: root.filter-text != "" ? "No matches for “\{root.filter-text}”" : "No browsers found";
                            font-size: 12px;
                            color: AppPalette.muted-label-color;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    height: root.separator-height;
                    background: AppPalette.separator-color;
                }

                // what the keyboard can do, plus the "···" options menu
                HorizontalLayout {
                    height: root.action-bar-height;
                    padding-left: 12px;
                    padding-right: 6px;
                    spacing: 12px;

                    ActionHint { keys: "⏎"; label: "Open"; }
                    ActionHint { keys: "⇧⏎"; label: "Private"; }
                    ActionHint {
                        keys: Platform.os == OperatingSystemType.macos ? "⌘C" : "Ctrl+C";
                        label: "Copy";
                    }
                    Rectangle { horizontal-stretch: 1; }

                    om := ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: "Refresh";
                                activated => { root.refresh(); }
                            }
                            if root.show-set-as-default: MenuItem {
                                title: "Make Browsers Default";
                                activated => { root.set-browsers-default(); }
                            }
                            Menu {
                                title: "Restore";
                                if root.restorable-app-profiles.length == 0: MenuItem {
                                    title: "No hidden apps or profiles";
                                    enabled: false;
                                }
                                for p[i] in root.restorable-app-profiles: MenuItem {
                                    title: p.full-name;
                                    activated => { root.restore-profile(p.unique-id); }
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "Settings…";
                                activated => { root.show-settings(); }
                            }
                            MenuItem {
                                title: "About";
                                activated => { root.show-about(); }
                            }
                            MenuItem {
                                title: "Quit";
                                activated => { root.quit(); }
                            }
                        }

                        // keeping the visual content inside the ContextMenuArea instead of next
                        // to it as a sibling, so .show()'s point argument and mouse-x/mouse-y
                        // below share the same coordinate space
                        VerticalLayout {
                            alignment: center;
                            options-ta := TouchArea {
                                width: 26px;
                                height: 20px;
                                clicked => { om.show({x: self.x + self.mouse-x, y: self.y + self.mouse-y}); }
                                Rectangle {
                                    border-radius: 5px;
                                    background: options-ta.has-hover ? AppPalette.neutral-selection-background-color : transparent;
                                    Text {
                                        text: "···";
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: AppPalette.muted-label-color;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
